@page
@model MovieTicketBooking.Pages.TheaterAdmin.Screen.PreviewScreenModel

@{
    ViewData["Title"] = "Preview Screen";
}

<link rel="stylesheet" href="~/css/ScreenLayout/preview-screen.css" />
<link rel="stylesheet" href="~/css/ScreenLayout/allocate-seats.css" />

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0">
                    Allocate Seat Categories
                </h3>

                <small class="text-muted">
                    Assign a seat category for each seating row.
                </small>
            </div>

        </div>
    </div>

    <!-- Screen Banner -->
    <div class="text-center mb-5">

        <div class="screen-banner">

            SCREEN

        </div>

    </div>

    <!-- Rows -->
    <div id="seatAllocationContainer">

        @foreach (var row in Model.Layout.Rows.OrderBy(x => x.DisplayOrder))
        {
            if (row.RowType == "EmptyWalkway")
            {
                <div class="walkway-row my-4">

                    <hr />

                    <div class="text-center text-secondary fw-bold">

                        WALKWAY

                    </div>

                    <hr />

                </div>

                continue;
            }

            <div class="card mb-3 shadow-sm seat-row-card">

                <div class="card-body">

                    <div class="row align-items-center">

                        <!-- Row Name -->
                        <div class="col-lg-2">

                            <h5 class="mb-0">

                                Row @row.RowName

                            </h5>

                        </div>

                        <!-- Seat Preview -->
                        @{
                            var category = Model.Categories
                                .FirstOrDefault(x => x.Id == row.SeatCategoryId);
                        }

                        <!-- Seat Preview -->
                        <div class="col-lg-6">

                            <div class="seat-container">

                                @foreach (var seat in row.Seats)
                                {
                                    string css = seat.SeatType == "Walkway"
                                        ? "seat walkway-seat"
                                        : "seat";

                                    <div class="@css">

                                        @seat.SeatLabel

                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Category -->
                        <div class="col-lg-4 text-end">

                            <span class="badge bg-primary fs-6">

                                @(category?.CategoryName ?? "Not Allocated")

                            </span>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Buttons -->

    <div class="d-flex justify-content-between mt-5">

        <button id="btnBack"
                class="btn btn-outline-secondary">

            ← Back

        </button>

        <button id="btnContinue"
                class="btn btn-primary">

            Continue →

        </button>

    </div>

</div>

@section Scripts {
    <script>
        window.screenLayout = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Layout));
    </script>

    console.log(window.screenLayout);
    <script src="~/js/ScreenLayout/preview-screen.js"></script>
}