@page
@model MovieTicketBooking.Pages.TheaterAdmin.Screen.ConfigureSeatsModel

@{
    ViewData["Title"] = "Configure Seats";
}

<link rel="stylesheet" href="~/css/ScreenLayout/configure-seats.css" />

<input type="hidden" id="ScreenId" value="@Model.ScreenId" />

<div class="container-fluid mt-4">

    <!-- Wizard -->
    <div class="row mb-4">

        <div class="col-12">

            <ul class="wizard">

                <li class="active">
                    <span>1</span>
                    <p>Screen Details</p>
                </li>

                <li class="active">
                    <span>2</span>
                    <p>Configure Seats</p>
                </li>

                <li>
                    <span>3</span>
                    <p>Allocate Seats</p>
                </li>

                <li>
                    <span>4</span>
                    <p>Preview</p>
                </li>

            </ul>

        </div>

    </div>

    <!-- Configuration Card -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h4 class="mb-0">
                Configure Screen Seats
            </h4>

        </div>

        <div class="card-body">

            <!-- Validation -->

            <div id="validationBox"
                 class="alert alert-danger d-none mb-3">
            </div>

            <div class="row g-3">

                <div class="col-md-2">

                    <label class="form-label">

                        Row Name

                    </label>

                    <input type="text"
                           id="txtRowName"
                           class="form-control"
                           readonly />

                </div>

                <div class="col-md-3">

                    <label class="form-label">

                        Row Type

                    </label>

                    <select id="ddlType"
                            class="form-select">

                        <option value="Seats">
                            Seats
                        </option>

                        <option value="EmptyWalkway">
                            Empty Walkway
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <label class="form-label">

                        Total Seats

                    </label>

                    <input type="number"
                           id="txtSeats"
                           min="0"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <label class="form-label">

                        Walkway Count

                    </label>

                    <input type="number"
                           id="txtWalkway"
                           min="0"
                           class="form-control" />

                </div>

                <div class="col-md-3 d-flex align-items-end">

                    <button type="button"
                            id="btnSubmit"
                            class="btn btn-primary w-100">

                        Add Row

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Generated Rows -->

    <div class="card shadow-sm mt-4">

        <div class="card-header">

            <h5 class="mb-0">

                Screen Layout

            </h5>

        </div>

        <div class="card-body">

            <div id="layoutContainer">
            </div>

        </div>

    </div>

    <!-- Footer Buttons -->

    <div class="d-flex justify-content-between mt-4">

        <a asp-page="/TheaterAdmin/ScreenList"
           class="btn btn-secondary">

            Back

        </a>

        <button type="button"
                id="btnContinue"
                class="btn btn-success">

            Continue

        </button>

    </div>

</div>

@section Scripts {
    <script>
        window.screenLayout =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Layout));

        console.log(window.screenLayout);
    </script>

    <script src="~/js/ScreenLayout/configure-seats.js"></script>

}