@page
@model MovieTicketBooking.Pages.TheaterAdmin.Screen.ScreenCreationModel

@{
    ViewData["Title"] = "Create Screen (Step 1)";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <!-- 4-Step Wizard Stepper -->
        <div class="wizard-stepper mb-5">
            <div class="wizard-step active">
                <div class="wizard-icon">1</div>
                <div class="wizard-label">Screen Details</div>
            </div>
            <div class="wizard-step">
                <div class="wizard-icon">2</div>
                <div class="wizard-label">Configure Seats</div>
            </div>
            <div class="wizard-step">
                <div class="wizard-icon">3</div>
                <div class="wizard-label">Allocate Categories</div>
            </div>
            <div class="wizard-step">
                <div class="wizard-icon">4</div>
                <div class="wizard-label">Preview & Create</div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 bg-success-subtle text-success mb-4 rounded-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            </div>
        }

        <form method="post">
            <div class="card card-cinema border-0">
                <div class="card-cinema-header d-flex align-items-center gap-3">
                    <div class="icon-box bg-gradient-danger text-white rounded-3 p-2">
                        <i class="fa-solid fa-tv"></i>
                    </div>
                    <h5 class="fw-bold mb-0 text-white">Step 1: Screen Technical Specifications</h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Screen Name</label>
                            <input asp-for="Screen.ScreenName" class="form-control" placeholder="Screen 1 (IMAX Laser)" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Screen Code</label>
                            <input asp-for="Screen.ScreenCode" class="form-control" placeholder="SCR-01" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Floor Level</label>
                            <input asp-for="Screen.Floor" class="form-control" placeholder="Level 2, Hall B" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Screen Type</label>
                            <select asp-for="Screen.ScreenType" class="form-select">
                                <option value="">-- Select Screen Type --</option>
                                @foreach (var item in Model.ScreenTypes)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Audio Technology</label>
                            <select asp-for="Screen.AudioTechnology" class="form-select">
                                <option value="">-- Select Audio Technology --</option>
                                @foreach (var item in Model.AudioTechnologies)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Seating Type</label>
                            <select asp-for="Screen.SeatingType" class="form-select">
                                <option value="">-- Select Seating Type --</option>
                                @foreach (var item in Model.SeatingTypes)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-light-emphasis fw-medium">Screen Amenities (Hold Ctrl/Cmd for multiple)</label>
                            <select asp-for="Screen.AmenId" multiple class="form-select" id="amenitySelect" style="height: 120px;">
                                @foreach (var item in Model.Amenities)
                                {
                                    <option value="@item.Id">@item.AmenityName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light-emphasis fw-medium">Operational Status</label>
                            <select asp-for="Screen.Status" class="form-select">
                                <option value="true">Active Operational</option>
                                <option value="false">Inactive / Maintenance</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-dark-subtle border-top border-secondary-subtle p-4 d-flex justify-content-between align-items-center">
                    <a asp-page="/TheaterAdmin/Theater/TheaterListing" class="btn btn-outline-secondary px-4 py-2.5">
                        <i class="fa-solid fa-arrow-left me-2"></i>Back to Theater
                    </a>
                    <button type="submit" class="btn btn-danger-gradient px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2">
                        <span>Continue to Seat Config</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

