@page
@model MovieTicketBooking.Pages.TheaterAdmin.Dashboard.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Shared/_AppLayout.cshtml";
    ViewData["Parent"] = "Home > Dashboard";
}

<link rel="stylesheet" href="~/css/Dashboard/Dashboard.css" asp-append-version="true" />

<div class="dashboard-container">
    <!-- KPI Row -->
    <div class="kpi-row">
        <div class="kpi-card">
            <div class="kpi-title">Today's Total Bookings</div>
            <div class="kpi-value">@Model.DashboardData.Metrics.TodayBookings</div>
            <div class="kpi-subtitle">Bookings confirmed today</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Active Screens</div>
            <div class="kpi-value">@Model.DashboardData.Metrics.ActiveScreens / @Model.DashboardData.Metrics.TotalScreens</div>
            <div class="kpi-subtitle">Operating across @Model.DashboardData.Metrics.TotalTheaters theaters</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Total Theaters</div>
            <div class="kpi-value">@Model.DashboardData.Metrics.TotalTheaters</div>
            <div class="kpi-subtitle">Total managed theaters</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Active Movies</div>
            <div class="kpi-value">@Model.DashboardData.Metrics.ActiveMovies</div>
            <div class="kpi-subtitle">Currently playing</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Weekly Revenue</div>
            <div class="kpi-value">₹@(Model.DashboardData.Metrics.WeeklyRevenue.ToString("N0"))</div>
            <div class="kpi-subtitle">Revenue in the last 7 days</div>
        </div>
    </div>

    <!-- Booking Trends Chart -->
    <div class="chart-section">
        <div class="chart-header">
            <div class="chart-title">Booking trends</div>
            <div class="update-info"><i class="fa-solid fa-clock"></i> Revenue and occupancy data are updated every 30 minutes</div>
        </div>
        <div style="position: relative; height: 300px; width: 100%;">
            <canvas id="bookingChart"></canvas>
        </div>
    </div>

    <!-- Bottom Row: Recent Activity & Top Movies -->
    <div class="bottom-row">
        <div class="recent-activity">
            <div class="section-title">Recent activity</div>
            @if(Model.DashboardData.RecentActivities.Any())
            {
                <ul class="activity-list">
                    @foreach (var activity in Model.DashboardData.RecentActivities)
                    {
                        <li class="activity-item">
                            <div class="activity-icon">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <div class="activity-details">
                                <div class="activity-type">@activity.ActionType</div>
                                <div class="activity-desc">@activity.ActionDescription</div>
                                <div class="activity-time">@activity.CreatedAtString</div>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No recent activity found.</p>
            }
        </div>

        <div class="top-movies">
            <div class="section-title">Top 5 performing movies</div>
            @if(Model.DashboardData.TopMovies.Any())
            {
                <div class="movie-list">
                    @foreach(var movie in Model.DashboardData.TopMovies)
                    {
                        var posterUrl = !string.IsNullOrEmpty(movie.PosterUrl) ? movie.PosterUrl : "/images/default-movie.jpg";
                        <div class="movie-item">
                            <div class="movie-rank">#@movie.Rank</div>
                            <img src="@posterUrl" alt="@movie.MovieName" class="movie-poster" />
                            <div class="movie-details">
                                <div class="movie-name">@movie.MovieName</div>
                                <div class="movie-meta">@movie.Duration mins | @movie.ReleaseYear | @movie.Language | @movie.Format | @movie.ScreenCount Screens</div>
                                <div class="movie-stats">
                                    <div class="stat-item">
                                        <span class="text-muted">Revenue</span>
                                        <span class="stat-value">₹@(movie.Revenue.ToString("N0"))</span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="text-muted">Occupancy</span>
                                        <span class="stat-value">@(movie.Occupancy.ToString("0.0"))%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No movies are currently performing.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Dashboard/Dashboard.js" asp-append-version="true"></script>
}
