@page
@model MovieTicketBooking.Pages.TheaterAdmin.Settings.SettingsModel
@{
    ViewData["Title"] = "Settings";
    Layout = "/Pages/Shared/_AppLayout.cshtml";
    ViewData["Parent"] = "Home > Settings";
}

<link rel="stylesheet" href="~/css/Settings/Settings.css" />

<div class="settings-container">
    <div class="settings-header">
        <h2>Profile Settings</h2>
    </div>

    <div id="alertMsg" class="alert"></div>

    <input type="hidden" id="hdnUserId" value="@Model.CurrentUserId" />

    <div class="form-group">
        <label>Profile Image</label>
        <img id="imgProfile" src="@(Model.Profile?.ProfileImagePath ?? "/images/default-avatar.png")" class="profile-image" />
    </div>

    <div class="form-group">
        <label>Username</label>
        <input type="text" id="txtUsername" class="form-control" value="@Model.Profile?.Username" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" id="txtEmail" class="form-control" value="@Model.Profile?.Email" />
    </div>

    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" id="txtPhone" class="form-control" value="@Model.Profile?.PhoneNumber" />
    </div>

    <div class="form-group">
        <label>Country</label>
        <input type="text" id="txtCountry" class="form-control" value="@Model.Profile?.Country" />
    </div>

    <button id="btnSaveProfile" class="btn-primary">Update Profile</button>

    <div class="settings-header" style="margin-top:40px;">
        <h2>Security Settings</h2>
    </div>

    <div class="form-group">
        <label>Current Password</label>
        <input type="password" id="txtCurrentPassword" class="form-control" />
    </div>

    <div class="form-group">
        <label>New Password</label>
        <input type="password" id="txtNewPassword" class="form-control" />
    </div>

    <button id="btnChangePassword" class="btn-primary">Change Password</button>
</div>

@section Scripts {
    <script>
        window.AntiForgeToken = '@Html.AntiForgeryToken()';
    </script>
    <script src="~/js/Settings/Settings.js"></script>
}
