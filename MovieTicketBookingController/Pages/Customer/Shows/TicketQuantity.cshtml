@page "{id:int}"
@model MovieTicketBooking.Pages.Customer.Shows.TicketQuantityModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Select Quantity";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary-subtle shadow-lg">
                <div class="card-header border-bottom border-secondary-subtle bg-transparent p-4 text-center">
                    <h3 class="text-white fw-bold mb-1" style="font-family: 'Outfit', sans-serif;">@Model.ShowDetails.MovieName</h3>
                    <p class="text-brand mb-0 fw-bold">@Model.ShowDetails.TheaterName - @Model.ShowDetails.ScreenName</p>
                    <div class="text-muted small mt-2">
                        <i class="fa-regular fa-calendar me-1"></i> @Model.ShowDetails.ShowDate 
                        <span class="mx-2">|</span> 
                        <i class="fa-regular fa-clock me-1"></i> @Model.ShowDetails.ShowTime
                    </div>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <h4 class="text-white mb-4">How many tickets?</h4>
                    
                    <form method="post">
                        <div class="d-flex justify-content-center align-items-center mb-4">
                            <button type="button" id="btnMinus" class="btn btn-outline-secondary rounded-circle" style="width: 50px; height: 50px; font-size: 1.2rem;">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            
                            <input type="number" id="ticketQty" name="quantity" value="2" min="1" max="10" class="form-control bg-transparent text-white text-center border-0 fs-1 fw-bold mx-3 shadow-none" style="width: 80px;" readonly />
                            
                            <button type="button" id="btnPlus" class="btn btn-outline-secondary rounded-circle" style="width: 50px; height: 50px; font-size: 1.2rem;">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        
                        <div class="text-muted small mb-5">Maximum allowed: 10</div>
                        
                        <button type="submit" class="btn btn-brand w-100 py-3 rounded-pill fw-bold fs-5 shadow-lg">Continue</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const minQty = 1;
            const maxQty = 10;
            const $qtyInput = $('#ticketQty');
            
            $('#btnMinus').click(function() {
                let current = parseInt($qtyInput.val());
                if (current > minQty) {
                    $qtyInput.val(current - 1);
                }
            });
            
            $('#btnPlus').click(function() {
                let current = parseInt($qtyInput.val());
                if (current < maxQty) {
                    $qtyInput.val(current + 1);
                }
            });
        });
    </script>
}
