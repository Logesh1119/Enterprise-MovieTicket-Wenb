@page
@model MovieTicketBooking.Pages.Customer.Booking.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-1" style="font-family: 'Outfit', sans-serif;">My Bookings</h1>
            <p class="text-muted mb-0">View all your upcoming and past bookings</p>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-3 mb-4">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["Message"]
        </div>
    }

    @if (!Model.Bookings.Any())
    {
        <div class="text-center py-5 text-muted bg-dark rounded-4 border border-secondary-subtle">
            <i class="fa-solid fa-ticket fa-3x mb-3"></i>
            <h5>No bookings found</h5>
            <p>You haven't made any bookings yet.</p>
            <a asp-page="/Customer/Movies/Index" class="btn btn-brand rounded-pill px-4 mt-3">Browse Movies</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var booking in Model.Bookings)
            {
                var isPast = booking.ShowDate < System.DateTime.Today;
                var opacityClass = isPast ? "opacity-75" : "";
                
                <div class="col @opacityClass">
                    <div class="card h-100 bg-dark border-secondary-subtle">
                        <div class="card-header border-bottom border-secondary-subtle bg-transparent p-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Booking ID: #@booking.BookingId</span>
                            @if (booking.Status == "Confirmed" && !isPast)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill">Confirmed</span>
                            }
                            else if (isPast)
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 rounded-pill">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 rounded-pill">@booking.Status</span>
                            }
                        </div>
                        <div class="card-body p-4 d-flex">
                            <div class="me-4 text-center">
                                <div class="text-danger small fw-bold text-uppercase tracking-wider">@booking.ShowDate.ToString("MMM")</div>
                                <div class="fs-2 fw-bold text-white" style="font-family: 'Outfit', sans-serif;">@booking.ShowDate.ToString("dd")</div>
                            </div>
                            <div class="flex-grow-1 border-start border-secondary-subtle ps-4">
                                <h5 class="fw-bold text-white mb-1" style="font-family: 'Outfit', sans-serif;">@booking.MovieName</h5>
                                <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i>@booking.TheaterName</p>
                                <p class="text-muted small mb-2"><i class="fa-solid fa-clock me-1"></i>@booking.ShowTime.ToString(@"hh\:mm") | <i class="fa-solid fa-screen-users ms-1 me-1"></i>@booking.ScreenName</p>
                                <div class="d-flex justify-content-between align-items-end mt-3">
                                    <div>
                                        <div class="text-muted small mb-1">Seats</div>
                                        <div class="text-white fw-bold">@string.Join(", ", booking.SeatLabels)</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small mb-1">Total</div>
                                        <div class="text-white fw-bold">&#8377;@booking.TotalAmount.ToString("0.00")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (!isPast && booking.Status == "Confirmed")
                        {
                            <div class="card-footer bg-transparent border-top border-secondary-subtle p-3 d-flex justify-content-between align-items-center">
                                <form method="post" asp-page-handler="Cancel" class="m-0" onsubmit="return confirm('Are you sure you want to cancel this booking? The ticket will be invalidated and seats will be released.');">
                                    <input type="hidden" name="id" value="@booking.BookingId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="fa-solid fa-xmark me-1"></i> Cancel Booking</button>
                                </form>
                                <a asp-page="/Customer/Booking/Confirmation" asp-route-id="@booking.BookingId" class="btn btn-brand btn-sm rounded-pill px-4">View Ticket</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
