@page "{id:int}"
@model MovieTicketBooking.Pages.Customer.Movies.DetailsModel
@{
    ViewData["Title"] = Model.Movie.MovieName;
}

<!-- Movie Banner / Header -->
<div class="movie-detail-banner position-relative overflow-hidden mb-5" style="height: 60vh; min-height: 500px;">
    @{
        var bgImage = !string.IsNullOrEmpty(Model.Movie.BannerUrl) ? Model.Movie.BannerUrl : (!string.IsNullOrEmpty(Model.Movie.PosterUrl) ? Model.Movie.PosterUrl : "/images/hero-bg.jpg");
    }
    <div class="position-absolute w-100 h-100" style="background: url('@bgImage') center/cover no-repeat; filter: blur(5px) brightness(0.3); transform: scale(1.1);"></div>
    <div class="container h-100 position-relative">
        <div class="row h-100 align-items-center">
            <div class="col-md-3 d-none d-md-block">
                @if (!string.IsNullOrEmpty(Model.Movie.PosterUrl))
                {
                    <img src="@Model.Movie.PosterUrl" class="img-fluid rounded-4 shadow-lg border border-secondary" alt="@Model.Movie.MovieName">
                }
            </div>
            <div class="col-md-9 text-white">
                <h1 class="display-4 fw-bold mb-3" style="font-family: 'Outfit', sans-serif;">@Model.Movie.MovieName</h1>
                
                <div class="d-flex flex-wrap gap-3 mb-4 align-items-center text-muted">
                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill">@Model.Movie.CertificateName</span>
                    <span><i class="fa-regular fa-clock me-1"></i> @Model.Movie.Duration mins</span>
                    <span><i class="fa-regular fa-calendar me-1"></i> @Model.Movie.ReleaseDate?.ToString("MMM dd, yyyy")</span>
                    <span>@Model.Movie.Genres</span>
                </div>

                <p class="lead mb-4 text-light" style="max-width: 800px; font-size: 1.1rem; line-height: 1.6;">@Model.Movie.MovieDescription</p>
                
                @if (!string.IsNullOrEmpty(Model.Movie.TrailerUrl))
                {
                    <a href="@Model.Movie.TrailerUrl" target="_blank" class="btn btn-outline-light rounded-pill px-4 py-2">
                        <i class="fa-solid fa-play me-2"></i> Watch Trailer
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container mb-5 pb-5">
    <div class="row">
        <div class="col-12">
            <h3 class="fw-bold mb-4" style="font-family: 'Outfit', sans-serif;">Book Tickets</h3>
            
            <!-- Date Selector -->
            <div class="date-selector-wrapper mb-5 pb-2 border-bottom border-secondary-subtle overflow-auto">
                <div class="d-flex gap-3 pb-2" style="min-width: max-content;">
                    @foreach (var date in Model.AvailableDates)
                    {
                        var dateStr = date.ToString("yyyy-MM-dd");
                        var isSelected = Model.SelectedDate == dateStr;
                        var activeClass = isSelected ? "bg-danger text-white border-danger" : "bg-dark text-muted border-secondary";
                        
                        <a asp-page="./Details" asp-route-id="@Model.Movie.Id" asp-route-selectedDate="@dateStr" class="text-decoration-none">
                            <div class="date-card border rounded-4 text-center px-4 py-2 @activeClass" style="transition: all 0.2s; min-width: 90px;">
                                <div class="text-uppercase small fw-bold">@date.ToString("MMM")</div>
                                <div class="fs-3 fw-bold" style="font-family: 'Outfit', sans-serif;">@date.ToString("dd")</div>
                                <div class="small">@date.ToString("ddd")</div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Theaters and Shows -->
            @if (!Model.Theaters.Any())
            {
                <div class="text-center py-5 text-muted bg-dark rounded-4 border border-secondary-subtle">
                    <i class="fa-solid fa-calendar-xmark fa-3x mb-3"></i>
                    <h5>No shows available for selected date</h5>
                    <p>Please select another date to view available shows.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var theater in Model.Theaters)
                    {
                        <div class="card bg-dark border-secondary-subtle">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h5 class="fw-bold text-white mb-1">@theater.TheaterName</h5>
                                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i> @theater.Location</p>
                                    </div>
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill"><i class="fa-solid fa-circle-info"></i> Info</button>
                                </div>
                                
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var show in theater.Shows)
                                    {
                                        <div class="show-chip">
                                            <a asp-page="/Customer/Shows/TicketQuantity" asp-route-id="@show.ShowId" class="btn btn-outline-light rounded-3 px-4 py-2 d-flex flex-column align-items-center text-decoration-none show-time-btn">
                                                <span class="fs-5 fw-bold text-success mb-1" style="font-family: 'Outfit', sans-serif;">@show.ShowTime.ToString(@"hh\:mm")</span>
                                                <span class="badge bg-secondary mb-1" style="font-size: 0.65rem;">@show.Format</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">@show.ScreenName</span>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .date-card:hover { transform: translateY(-3px); border-color: #e11d48 !important; color: #fff !important; }
        .show-time-btn { border-color: #3f3f46; background-color: #18181b; transition: all 0.2s; }
        .show-time-btn:hover { background-color: #27272a; border-color: #10b981; transform: translateY(-2px); }
    </style>
}
