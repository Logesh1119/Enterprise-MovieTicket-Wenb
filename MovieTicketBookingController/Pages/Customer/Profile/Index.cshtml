@page
@model MovieTicketBooking.Pages.Customer.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5 mt-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="card bg-dark border-secondary-subtle sticky-top" style="top: 100px;">
                <div class="card-body text-center p-4">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-brand text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 2.5rem; margin: 0 auto;">
                            @Model.Username.Substring(0, 1).ToUpper()
                        </div>
                    </div>
                    <h5 class="fw-bold text-white mb-1" style="font-family: 'Outfit', sans-serif;">@Model.Username</h5>
                    <p class="text-muted small mb-4">@Model.Email</p>
                    
                    <div class="d-grid gap-2 text-start">
                        <a asp-page="/Customer/Profile/Index" class="btn btn-brand text-start px-3"><i class="fa-regular fa-user me-2"></i> Overview</a>
                        <a asp-page="/Customer/Booking/MyBookings" class="btn btn-outline-secondary text-start px-3 border-0 text-light"><i class="fa-solid fa-ticket me-2"></i> My Bookings</a>
                        <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="m-0 d-grid">
                            <button type="submit" class="btn btn-outline-danger text-start px-3 border-0"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Stats overview -->
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="card bg-dark border-secondary-subtle h-100">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                                <i class="fa-solid fa-film fa-2x"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Movie Enthusiast</h6>
                                <h4 class="fw-bold text-white mb-0" style="font-family: 'Outfit', sans-serif;">Welcome Back</h4>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-dark border-secondary-subtle h-100">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                                <i class="fa-solid fa-ticket fa-2x"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Quick Action</h6>
                                <a asp-page="/Customer/Movies/Index" class="text-success text-decoration-none fw-bold">Book a new ticket <i class="fa-solid fa-arrow-right ms-1"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Bookings -->
            <div class="d-flex justify-content-between align-items-end mb-4">
                <h4 class="fw-bold mb-0 text-white" style="font-family: 'Outfit', sans-serif;">Recent Bookings</h4>
                <a asp-page="/Customer/Booking/MyBookings" class="text-brand text-decoration-none small fw-bold">View All</a>
            </div>

            @if (!Model.RecentBookings.Any())
            {
                <div class="card bg-dark border-secondary-subtle text-center py-5">
                    <div class="card-body">
                        <i class="fa-solid fa-ticket fa-3x text-muted mb-3"></i>
                        <h6 class="text-white">No recent bookings</h6>
                        <p class="text-muted small mb-0">When you book tickets, they will appear here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 g-3">
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <div class="col">
                            <div class="card bg-dark border-secondary-subtle h-100">
                                <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary bg-opacity-25 rounded-3 p-2 text-center me-3 border border-secondary-subtle" style="min-width: 60px;">
                                            <div class="text-danger small fw-bold text-uppercase tracking-wider" style="font-size: 0.65rem;">@booking.ShowDate.ToString("MMM")</div>
                                            <div class="fs-4 fw-bold text-white lh-1">@booking.ShowDate.ToString("dd")</div>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-white mb-1 text-truncate" style="max-width: 200px;">@booking.MovieName</h6>
                                            <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i>@booking.TheaterName</p>
                                        </div>
                                    </div>
                                    <div class="text-end d-none d-md-block">
                                        <span class="badge @(booking.Status == "Confirmed" ? "bg-success text-success" : booking.Status == "Cancelled" ? "bg-danger text-danger" : "bg-warning text-warning") bg-opacity-25 border border-opacity-25 mb-1 rounded-pill px-3">@booking.Status</span>
                                        <div class="text-white fw-bold">&#8377;@booking.TotalAmount.ToString("0.00")</div>
                                    </div>
                                    <div class="d-md-none text-end">
                                        <div class="text-white fw-bold">&#8377;@booking.TotalAmount.ToString("0.00")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
