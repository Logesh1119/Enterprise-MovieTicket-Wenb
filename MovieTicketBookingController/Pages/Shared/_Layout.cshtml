@{
    var currentPath = Context.Request.Path.Value ?? "";
    bool isAuthPage = currentPath.Contains("/Account/", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineMax Movie Booking</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MovieTicketBooking.styles.css" asp-append-version="true" />
</head>
<body class="@(isAuthPage ? "auth-body" : "bg-main text-body")">
    @Html.AntiForgeryToken()

    @if (isAuthPage)
    {
        <!-- Auth Layout Wrapper -->
        <div class="auth-wrapper">
            @RenderBody()
        </div>
    }
    else
    {
        <!-- Admin & Dashboard Layout Shell with Sidebar -->
        <div class="app-layout d-flex min-vh-100">
            <!-- Sidebar -->
            <aside class="app-sidebar bg-card border-end border-secondary-subtle d-flex flex-column">
                <!-- Brand Header -->
                <div class="sidebar-brand p-4 d-flex align-items-center gap-3 border-bottom border-secondary-subtle">
                    <div class="brand-icon bg-gradient-danger text-white rounded-3 d-flex align-items-center justify-content-center shadow-lg" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-film fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-white tracking-wide">CineMax</h5>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.65rem;">Management Portal</span>
                    </div>
                </div>

                <!-- Navigation Links -->
                <div class="sidebar-nav p-3 flex-grow-1 overflow-y-auto">
                    <div class="nav-section-title text-muted text-uppercase fw-semibold px-3 mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Super Admin</div>
                    <ul class="nav nav-pills flex-column gap-1 mb-4">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-3 px-3 py-2.5 rounded-3 @(currentPath.Contains("/Admin/Create") ? "active bg-gradient-danger text-white shadow" : "text-light-emphasis hover-bg-dark")" asp-page="/Admin/Create">
                                <i class="fa-solid fa-user-shield text-danger-gradient"></i>
                                <span>Create Theater Admin</span>
                            </a>
                        </li>
                    </ul>

                    <div class="nav-section-title text-muted text-uppercase fw-semibold px-3 mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Theater Admin</div>
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-3 px-3 py-2.5 rounded-3 @(currentPath.Contains("/TheaterAdmin/Theater/TheaterListing") ? "active bg-gradient-danger text-white shadow" : "text-light-emphasis hover-bg-dark")" asp-page="/TheaterAdmin/Theater/TheaterListing">
                                <i class="fa-solid fa-building-flag text-danger-gradient"></i>
                                <span>Theaters</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-3 px-3 py-2.5 rounded-3 @(currentPath.Contains("/TheaterAdmin/MovieCreation") ? "active bg-gradient-danger text-white shadow" : "text-light-emphasis hover-bg-dark")" asp-page="/TheaterAdmin/MovieCreation">
                                <i class="fa-solid fa-clapperboard text-danger-gradient"></i>
                                <span>Create Movie</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-3 px-3 py-2.5 rounded-3 @(currentPath.Contains("/TheaterAdmin/Screen/") ? "active bg-gradient-danger text-white shadow" : "text-light-emphasis hover-bg-dark")" asp-page="/TheaterAdmin/Screen/ScreenCreation">
                                <i class="fa-solid fa-tv text-danger-gradient"></i>
                                <span>Screen & Seat Layout</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- User Footer Profile -->
                <div class="sidebar-footer p-3 border-top border-secondary-subtle">
                    <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-dark-subtle border border-secondary-subtle">
                        <div class="avatar bg-danger rounded-circle text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-white text-truncate small">Admin Portal</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Active Session</div>
                        </div>
                        <a asp-page="/Account/Login" class="btn btn-sm btn-outline-danger border-0 text-muted hover-text-danger" title="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Main Content Canvas -->
            <div class="app-main flex-grow-1 d-flex flex-column min-w-0">
                <!-- Top Navbar Header -->
                <header class="app-header bg-card border-bottom border-secondary-subtle px-4 py-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary d-md-none border-0" id="sidebarToggle">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <h4 class="mb-0 fw-bold text-white tracking-tight">@ViewData["Title"]</h4>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-dark-subtle text-light-emphasis border border-secondary-subtle px-3 py-2 rounded-pill small d-none d-sm-inline-flex align-items-center gap-2">
                            <span class="status-dot bg-success rounded-circle" style="width: 8px; height: 8px;"></span>
                            Backend Connected
                        </span>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main role="main" class="flex-grow-1 p-4 p-lg-5 container-fluid">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer border-top border-secondary-subtle py-3 px-4 text-center text-muted small">
                    <div>&copy; 2026 CineMax Theater Platform &bull; ASP.NET Core Razor Pages</div>
                </footer>
            </div>
        </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>