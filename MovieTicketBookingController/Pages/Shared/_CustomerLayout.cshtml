@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineMax</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #09090b; color: #f8f9fa; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
        .customer-navbar { background-color: rgba(9, 9, 11, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid #27272a; }
        .nav-link { color: #a1a1aa; font-weight: 500; transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: #fff; }
        .btn-brand { background: linear-gradient(135deg, #e11d48, #be123c); color: white; border: none; }
        .btn-brand:hover { background: linear-gradient(135deg, #be123c, #9f1239); color: white; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg customer-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Customer/Home/Index">
                <div class="bg-gradient-danger text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: linear-gradient(135deg, #e11d48, #be123c);">
                    <i class="fa-solid fa-film"></i>
                </div>
                <span class="fw-bold tracking-wide" style="font-family: 'Outfit', sans-serif; color: #fff;">CineMax</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Customer/Home/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Customer/Movies/Index">Movies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Customer/Theaters/Index">Theaters</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="nav-link" asp-page="/Customer/Booking/MyBookings">My Bookings</a>
                        <div class="dropdown">
                            <button class="btn btn-dark dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown">
                                <i class="fa-regular fa-user me-2"></i> @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                <li><a class="dropdown-item" asp-page="/Customer/Profile/Index">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Login" asp-page-handler="Logout">
                                        <button type="submit" class="dropdown-item text-danger">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link" asp-page="/Account/Login">Sign In</a>
                        <a class="btn btn-brand rounded-pill px-4 py-2" asp-page="/Account/Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="min-vh-100">
        @RenderBody()
    </main>

    <footer class="py-5 mt-5 border-top" style="border-color: #27272a !important; background-color: #09090b;">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
                <i class="fa-solid fa-film text-danger fs-3"></i>
                <span class="fw-bold fs-4 tracking-wide" style="font-family: 'Outfit', sans-serif; color: #fff;">CineMax</span>
            </div>
            <p class="text-muted mb-0">&copy; @DateTime.Now.Year CineMax Movie Ticket Booking. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
