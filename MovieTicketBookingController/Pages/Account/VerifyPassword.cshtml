@page
@model MovieTicketBooking.Pages.Account.VerifyOtpModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Enter confirmation code";
}

<div class="auth-container">
    <!-- MoviePlex Official Logo Centered Above Card -->
    <div class="auth-logo-container">
        <img src="~/uploads/UI/Movieplex_logo logo.png" alt="MoviePlex Logo" class="auth-logo" />
    </div>

    <!-- White Authentication Card -->
    <div class="auth-card">
        <h2 class="auth-title">Enter confirmation code</h2>
        <p class="auth-subtitle">We sent the code to @(string.IsNullOrEmpty(Model.VerifyOtpRequest?.Email) ? "your email" : Model.VerifyOtpRequest.Email), please enter that OTP code.</p>

        @* <!-- Validation Summary -->
        <div asp-validation-summary="All" class="auth-validation-summary" role="alert"></div> *@

        <!-- OTP Verification Form -->
        <form method="post">
            <input asp-for="VerifyOtpRequest.Email" type="hidden" />

            <!-- OTP Code Input -->
            <div class="auth-floating-group">
                <label>Enter code</label>
                <input asp-for="VerifyOtpRequest.Otp" class="auth-input" placeholder="158965" maxlength="6" required />
                <span asp-validation-for="VerifyOtpRequest.Otp" class="auth-field-validation"></span>
            </div>

            <!-- Two Buttons Side-by-Side (Matching Figma) -->
            <div class="auth-btn-row">
                <a asp-page="/Account/ForgetPassword" class="btn btn-auth-secondary">Resend code</a>
                <button type="submit" class="btn btn-auth-primary">Reset password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}