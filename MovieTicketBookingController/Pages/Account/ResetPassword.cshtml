@page
@model MovieTicketBooking.Pages.Account.ResetPasswordModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Enter new password";
}

<div class="auth-container">
    <!-- MoviePlex Official Logo Centered Above Card -->
    <div class="auth-logo-container">
        <img src="~/uploads/UI/Movieplex_logo logo.png" alt="MoviePlex Logo" class="auth-logo" />
    </div>

    <!-- White Authentication Card -->
    <div class="auth-card">
        <h2 class="auth-title">Enter new password</h2>
        <p class="auth-subtitle">Please login with your movieplex account credentials.</p>

        @* <!-- Validation Summary -->
        <div asp-validation-summary="All" class="auth-validation-summary" role="alert"></div> *@

        <!-- Reset Password Form -->
        <form method="post">
            <input asp-for="RequestPassword.Email" type="hidden" />
            <input asp-for="RequestPassword.Otp" type="hidden" />

            <!-- Email Address Field (Matching Figma Screenshot) -->
            <div class="auth-floating-group">
                <label>Email address</label>
                <input type="email" class="auth-input" value="@(string.IsNullOrEmpty(Model.RequestPassword?.Email) ? "deepika.param@marlensoft.com" : Model.RequestPassword.Email)" readonly style="background-color: #F9FAFB;" />
            </div>

            <!-- New Password Input -->
            <div class="auth-floating-group">
                <label>Password</label>
                <input asp-for="RequestPassword.NewPassword" type="password" id="newPassword" class="auth-input" placeholder="••••••••••••" required />
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility">
                    <i class="fa-regular fa-eye"></i>
                </button>
                <span asp-validation-for="RequestPassword.NewPassword" class="auth-field-validation"></span>
            </div>

            <!-- Confirm Password Input -->
            <div class="auth-floating-group">
                <label>Re-enter password</label>
                <input asp-for="RequestPassword.ConfirmPassword" type="password" id="confirmPassword" class="auth-input" placeholder="••••••••••••" required />
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('confirmPassword', this)" aria-label="Toggle password visibility">
                    <i class="fa-regular fa-eye"></i>
                </button>
                <span asp-validation-for="RequestPassword.ConfirmPassword" class="auth-field-validation"></span>
            </div>

            <!-- Primary Submit Button -->
            <button type="submit" class="btn btn-auth-primary" style="margin-top: 8px;">Login</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}