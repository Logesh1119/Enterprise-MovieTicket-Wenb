@page
@model MovieTicketBooking.Pages.Account.ForgotPasswordModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset your password";
}

<div class="auth-container">
    <!-- MoviePlex Official Logo Centered Above Card -->
    <div class="auth-logo-container">
        <img src="~/uploads/UI/Movieplex_logo logo.png" alt="MoviePlex Logo" class="auth-logo" />
    </div>

    <!-- White Authentication Card -->
    <div class="auth-card">
        <h2 class="auth-title">Reset your password</h2>
        <p class="auth-subtitle">Forget your password? Please enter you email and we will send you a 6 digit code.</p>

        <!-- Forgot Password Form -->
        <form method="post">
            <!-- Email Input -->
            <div class="auth-floating-group">
                <label>Email address</label>
                <input asp-for="ForgotPassword.Email" class="auth-input" placeholder="deepika.param@marlensoft.com" required />
                <span asp-validation-for="ForgotPassword.Email" class="auth-field-validation"></span>
            </div>

            <!-- Two Buttons Side-by-Side (Matching Figma) -->
            <div class="auth-btn-row">
                <a asp-page="/Account/Login" class="btn btn-auth-secondary">Back to login</a>
                <button type="submit" class="btn btn-auth-primary">Get code</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}